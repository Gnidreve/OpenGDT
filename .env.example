# Kopie als ".env" ablegen und anpassen (docker compose liest sie automatisch).

# Benutzer, dem die Dateien in ./data auf dem Host gehören (damit das PVS sie lesen/löschen darf).
# Auf dem Pi meist 1000/1000:  id -u  /  id -g
PUID=1000
PGID=1000

# Zeitzone für Datum/Uhrzeit der Worklist-Einträge, in Minuten gegenüber UTC.
# Deutschland: Winter 60, Sommer 120. Die Bridge kennt keine Sommerzeit-Umstellung – bei Bedarf hier ändern.
UTC_OFFSET_MINUTES=60

# AE-Titel des Ultraschallgeräts (am DP-50 unter "Local DICOM Service" eingestellt).
# Leer = Worklist-Einträge gelten für jedes Gerät.
DEVICE_AE=

# Pfad, unter dem das PVS die exportierten Bilder sieht (steht so in der GDT-Rückmeldung).
# Leer lassen = absoluter Pfad von ./data/export auf dem Pi (Verzeichnis, in dem du `docker compose` startest).
# Nur setzen, wenn das PVS die Bilder unter anderem Pfad sieht (z. B. Netzfreigabe \\SERVER\us).
# Wird `docker compose` mit sudo gestartet, ist der Pfad ggf. falsch: dann hier eintragen (der Startblock warnt).
PVS_EXPORT_PREFIX=

# Fester Dateiname der GDT-Rückmeldung (viele PVS erwarten genau einen Namen), leer = je Untersuchung eine Datei
GDT_RESULT_FILENAME=

# Optional: andere Bezugsquelle der Images (z. B. Mirror)
# ORTHANC_IMAGE=orthancteam/orthanc:latest
# RUST_IMAGE=rust:1-slim-bookworm
# RUNTIME_IMAGE=debian:bookworm-slim
# GNUMED_DB_IMAGE=postgres:15        # nicht 16: der GNUmed-22-Bootstrap läuft dort nicht
# GNUMED_BASE_IMAGE=ubuntu:24.04     # Basis des Bootstrap-Images (liefert gnumed-server 22.28)

# Zugangsdaten für Orthanc (Weboberfläche/REST). Leer lassen: beim ersten Start werden zufällige Passwörter erzeugt,
# anzeigen mit  docker/show-credentials.sh . Selbst setzen: 12-64 Zeichen aus A-Z a-z 0-9 . _ -
# Benutzer "praxis" = Weboberfläche, Benutzer "bridge" = die Bridge (braucht das Passwort nie selbst einzutippen).
ORTHANC_ADMIN_PASSWORD=
ORTHANC_BRIDGE_PASSWORD=

# Die Orthanc-Weboberfläche liegt fest auf Port 80 und nur auf 127.0.0.1: im Browser des Pi  http://localhost
# (Port 80 darf auf dem Pi sonst nicht belegt sein, z. B. durch nginx/apache.)
